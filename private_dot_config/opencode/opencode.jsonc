{
	"$schema": "https://opencode.ai/config.json",
	// "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
	"mcp": {
		"xcode": {
			"type": "local",
			"command": ["xcrun", "mcpbridge"],
			"enabled": true
		},
		"github": {
			"type": "remote",
			"url": "https://api.githubcopilot.com/mcp",
			"enabled": true,
			"oauth": false,
			"headers": {
				"Authorization": "Bearer {env:GITHUB_PAT}"
			}
		}
	},
	"formatter": {
		"swift-format": {
			"command": ["swift", "format", "format", "--in-place", "$FILE"],
			"extensions": [".swift"]
		}
	},
	"lsp": false,
	"permission": {
		"webfetch": "allow",
		"websearch": "allow",
		"external_directory": {
			"*": "ask",
			"/var/folders/73/f1g6gfkj1ws8s514gkcp89q40000gn/T/**": "allow",
			"/tmp/**": "allow",
			"/private/tmp/**": "allow"
		}
	}
}
